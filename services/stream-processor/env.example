# Stream Processor Environment Variables
# Copy this file to .env and modify as needed

# Environment
PROCESSOR_ENVIRONMENT=development

# Kafka Configuration
PROCESSOR_KAFKA_BROKERS=localhost:9092
PROCESSOR_KAFKA_TOPIC=events
PROCESSOR_KAFKA_CONSUMER_GROUP=stream-processor
PROCESSOR_KAFKA_AUTO_COMMIT=false
PROCESSOR_KAFKA_START_OFFSET=latest

# Redis Configuration
PROCESSOR_REDIS_ADDRESS=localhost:6379
PROCESSOR_REDIS_PASSWORD=
PROCESSOR_REDIS_DB=0
PROCESSOR_REDIS_POOL_SIZE=10
PROCESSOR_REDIS_MAX_RETRIES=3

# Processing Configuration
PROCESSOR_PROCESSING_WORKERS=4
PROCESSOR_PROCESSING_WINDOW_TYPE=tumbling
PROCESSOR_PROCESSING_WINDOW_SIZE=300
PROCESSOR_PROCESSING_WINDOW_SLIDE=60
PROCESSOR_PROCESSING_SESSION_GAP=600
PROCESSOR_PROCESSING_WATERMARK_DELAY=10
PROCESSOR_PROCESSING_MAX_OUT_OF_ORDER=60

# Metrics Configuration
PROCESSOR_METRICS_ENABLED=true
PROCESSOR_METRICS_PORT=9091
PROCESSOR_METRICS_PATH=/metrics

# Health Check Configuration
PROCESSOR_HEALTH_PORT=8091
PROCESSOR_HEALTH_PATH=/health
